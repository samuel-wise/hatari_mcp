{
  "version": 1,
  "id": "strict-boot",
  "name": "Strict determinism boot and decoded-RGBA capture",
  "description": "Shows strict stock-Hatari options; fidelity is still reported as approximate-frame.",
  "requires": {
    "env": [
      "HATARI_TOS"
    ],
    "rom": "emutos",
    "skip_reason": "HATARI_TOS is not set to an EmuTOS image"
  },
  "determinism": "strict",
  "seed": 1,
  "timeouts": {
    "scenario_ms": 60000,
    "step_ms": 30000
  },
  "config": {
    "profile": "st",
    "tos": "${HATARI_TOS}"
  },
  "steps": [
    {
      "id": "start",
      "tool": "emu_start",
      "args": {},
      "timeout_ms": 30000
    },
    {
      "id": "settle",
      "tool": "emu_wait_for_exit",
      "args": {
        "timeout_ms": 2000
      },
      "timeout_ms": 6000
    },
    {
      "id": "capture",
      "tool": "screen_frame_capture",
      "args": {},
      "timeout_ms": 15000,
      "capture": {
        "name": "strict-desktop",
        "kind": "screenshot",
        "format": "bmp",
        "hash": "rgba"
      }
    },
    {
      "id": "stop",
      "tool": "emu_stop",
      "args": {},
      "timeout_ms": 15000
    }
  ]
}
