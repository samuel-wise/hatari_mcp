{
  "version": 1,
  "id": "okami-shell-boot",
  "name": "Okami-Shell boot smoke",
  "description": "Stages only the prebuilt Files/ directory; the external tree stays read-only.",
  "requires": {
    "env": [
      "OKAMI_ROOT",
      "HATARI_TOS"
    ],
    "dirs": [
      "${OKAMI_ROOT}/Files"
    ],
    "files": [
      "${OKAMI_ROOT}/Files/GEM.PRG"
    ],
    "rom": "emutos",
    "skip_reason": "Okami-Shell Files/GEM.PRG or HATARI_TOS is not available"
  },
  "determinism": "tolerant",
  "timeouts": {
    "scenario_ms": 60000,
    "step_ms": 30000
  },
  "config": {
    "profile": "st",
    "tos": "${HATARI_TOS}",
    "autostart": "okami/Files/GEM.PRG",
    "gemdos_case": "upper"
  },
  "stage": [
    {
      "from": "${OKAMI_ROOT}/Files",
      "to": "okami/Files"
    }
  ],
  "steps": [
    {
      "id": "start",
      "tool": "emu_start",
      "args": {},
      "timeout_ms": 30000
    },
    {
      "id": "settle",
      "tool": "emu_wait_for_exit",
      "args": {
        "timeout_ms": 3000
      },
      "timeout_ms": 8000
    },
    {
      "id": "capture",
      "tool": "screen_frame_capture",
      "args": {},
      "timeout_ms": 15000,
      "capture": {
        "name": "okami-desktop",
        "kind": "screenshot",
        "format": "bmp",
        "hash": "rgba"
      }
    },
    {
      "id": "stop",
      "tool": "emu_stop",
      "args": {},
      "timeout_ms": 15000
    }
  ]
}
