{
  "version": 1,
  "id": "boot-capture-stop",
  "name": "Boot EmuTOS, settle, capture the screen and stop",
  "description": "Small real-Hatari smoke scenario used by the P6 integration test.",
  "requires": {
    "env": [
      "HATARI_TOS"
    ],
    "rom": "emutos",
    "skip_reason": "HATARI_TOS is not set to an EmuTOS image"
  },
  "determinism": "tolerant",
  "timeouts": {
    "scenario_ms": 45000,
    "step_ms": 30000
  },
  "config": {
    "profile": "st",
    "tos": "${HATARI_TOS}"
  },
  "steps": [
    {
      "id": "start",
      "tool": "emu_start",
      "args": {},
      "timeout_ms": 30000,
      "expect": {
        "ok": true
      }
    },
    {
      "id": "capture",
      "tool": "screen_frame_capture",
      "args": {},
      "timeout_ms": 15000,
      "capture": {
        "name": "desktop",
        "kind": "screenshot",
        "format": "bmp",
        "hash": "rgba"
      }
    },
    {
      "id": "stop",
      "tool": "emu_stop",
      "args": {},
      "timeout_ms": 15000
    }
  ],
  "teardown": [
    {
      "id": "teardown-stop",
      "tool": "emu_stop",
      "args": {
        "force": true
      },
      "timeout_ms": 15000
    }
  ]
}
